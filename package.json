{
  "name": "gdg-site",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler pages dev dist --port 8788",
    "partials": "node scripts/sync-partials.mjs",
    "db:migrate:local": "wrangler d1 migrations apply gdg-au --local",
    "db:migrate:remote": "wrangler d1 migrations apply gdg-au --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name gdg-africa-university --branch master",
    "test": "vitest run"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "tailwindcss": "^3.4.19",
    "vitest": "^1.4.0",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "marked": "^15.0.12"
  }
}
