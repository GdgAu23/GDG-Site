// Cloudflare Pages config. Only dist/ is uploaded (npm run build makes it);
// the repo root holds migrations, tests and local secrets.
{
  "name": "gdg-africa-university",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-06",
  "d1_databases": [
    { "binding": "DB", "database_name": "gdg-au", "database_id": "12175f91-6515-45e9-9c30-1bd3ab8f64f2" }
  ],
  "vars": {
    // Comma-separated Google accounts allowed into /admin
    "ADMIN_EMAILS": "gdscau2023@gmail.com",
    // OAuth client ID from Google Cloud Console (public value, safe to commit). Empty until created.
    "GOOGLE_CLIENT_ID": "717675065584-013v96a227rcu97fe12kclv20or6ka1p.apps.googleusercontent.com",
    // Who gets new-member/application alerts and the Monday WhatsApp post
    "ADMIN_NOTIFY": "gdscau2023@gmail.com",
    // Sender. Must be on a domain verified in Resend before students can receive mail.
    // The resend.dev sandbox address only reaches the Resend account owner (the club inbox).
    "MAIL_FROM": "GDG Africa University <onboarding@resend.dev>"
  }
  // Secrets (set with `npx wrangler pages secret put NAME`):
  //   SESSION_SECRET      random 32+ chars, signs admin sessions
  //   RESEND_API_KEY      Resend API key (send-only is enough)
  //   CRON_SECRET         shared with workers/weekly-cron, protects /api/mail/weekly
}
